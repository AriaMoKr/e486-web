# ========================================================
#   DOS AI Chatbot - Gateway Environment Configuration
# ========================================================

# Google Gemini API Key (Recommended for speed and generous free tier)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key
# Obtain from: https://platform.openai.com/
OPENAI_API_KEY=

# Anthropic API Key
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Local Ollama URL (Default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Optional: Custom OpenAI-compatible Base URL (Groq, OpenRouter, LocalAI)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
